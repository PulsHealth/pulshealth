{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HealthKit Data Type",
  "description": "Schema for HealthKit data type knowledge base entries",
  "type": "object",
  "required": [
    "identifier",
    "source",
    "type",
    "category",
    "human_readable_name",
    "short_description",
    "ios_introduced",
    "writable",
    "devices",
    "description",
    "references",
    "last_updated"
  ],
  "properties": {
    "identifier": {
      "type": "string",
      "description": "Full HealthKit identifier string (e.g., HKQuantityTypeIdentifierHeartRate)"
    },
    "source": {
      "type": "string",
      "enum": ["HealthKit", "GoogleHealth", "Garmin", "Fitbit", "Whoop", "Oura"],
      "description": "Data source platform"
    },
    "type": {
      "type": "string",
      "enum": ["HKQuantityType", "HKCategoryType", "HKCorrelationType", "HKCharacteristicType"],
      "description": "HealthKit type classification"
    },
    "category": {
      "type": "string",
      "description": "Grouping category (e.g., Vital Signs, Activity, Nutrition)"
    },
    "human_readable_name": {
      "type": "string",
      "description": "User-friendly name for the data type"
    },
    "short_description": {
      "type": "string",
      "description": "Brief one-sentence description"
    },
    "icon": {
      "type": ["string", "null"],
      "description": "SF Symbol name used in Apple Health app"
    },
    "color": {
      "type": ["string", "null"],
      "description": "Hex color used in Apple Health app"
    },
    "default_unit": {
      "type": ["string", "null"],
      "description": "Primary unit in HealthKit (for HKQuantityType)"
    },
    "supported_units": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "List of all supported units"
    },
    "unit_description": {
      "type": ["string", "null"],
      "description": "Human-readable unit explanation"
    },
    "aggregation_type": {
      "type": ["string", "null"],
      "enum": ["discrete", "cumulative", null],
      "description": "How samples aggregate: discrete (avg/min/max) or cumulative (sum)"
    },
    "statistics_options": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Available HKStatisticsOptions for queries"
    },
    "typical_range": {
      "type": ["object", "null"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "type": "string" },
        "notes": { "type": "string" }
      },
      "description": "Expected value range for the metric"
    },
    "clinical_ranges": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "population": { "type": "string" },
          "name": { "type": "string" },
          "normal": { "type": "string" },
          "low": { "type": "string" },
          "high": { "type": "string" },
          "rda": { "type": "string" },
          "systolic_range": { "type": "string" },
          "diastolic_range": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "description": "Clinical reference ranges by population or classification"
    },
    "category_values": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["value", "name"]
      },
      "description": "Enum values for HKCategoryType"
    },
    "component_types": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "identifier": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" }
        },
        "required": ["identifier", "description"]
      },
      "description": "Component sample types for HKCorrelationType (e.g., blood pressure contains systolic and diastolic components)"
    },
    "ios_introduced": {
      "type": "object",
      "required": ["version", "year"],
      "properties": {
        "version": { "type": "string" },
        "year": { "type": "integer" },
        "notes": { "type": "string" }
      },
      "description": "iOS version when this type was introduced"
    },
    "watchos_introduced": {
      "type": ["object", "null"],
      "properties": {
        "version": { "type": "string" },
        "year": { "type": "integer" },
        "notes": { "type": "string" }
      },
      "description": "watchOS version when this type was introduced"
    },
    "deprecated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this type is deprecated"
    },
    "deprecated_in": {
      "type": ["string", "null"],
      "description": "Version where deprecation occurred"
    },
    "writable": {
      "type": "boolean",
      "description": "Whether third-party apps can write this data type"
    },
    "requires_authorization": {
      "type": "boolean",
      "default": true,
      "description": "Whether user authorization is required"
    },
    "sensitive_data": {
      "type": "boolean",
      "default": false,
      "description": "Whether this requires additional privacy considerations"
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "capability": { "type": "string" },
          "series": { "type": "string" },
          "examples": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["name", "capability"]
      },
      "description": "Devices that can provide this data"
    },
    "primary_source": {
      "type": ["string", "null"],
      "description": "Most common/reliable data source"
    },
    "description": {
      "type": "string",
      "minLength": 200,
      "description": "Comprehensive markdown documentation (minimum 200 characters)"
    },
    "metadata_keys": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "description": { "type": "string" },
          "values": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["key", "description"]
      },
      "description": "Available HKMetadata keys for this type"
    },
    "related_types": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "identifier": { "type": "string" },
          "relationship": { "type": "string" }
        },
        "required": ["identifier", "relationship"]
      },
      "description": "Related HealthKit data types"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "type": {
            "type": "string",
            "enum": ["official", "medical", "research", "tutorial"]
          }
        },
        "required": ["title", "url", "type"]
      },
      "description": "Reference links for further reading"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "Date of last update (YYYY-MM-DD)"
    },
    "research_notes": {
      "type": ["string", "null"],
      "description": "Internal notes about research sources"
    }
  },
  "additionalProperties": false
}
