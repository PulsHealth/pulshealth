# Optional outside production: without a database the viewer uses demo data.
DATABASE_URL=

# Set it and the viewer asks for this password over HTTP Basic (any username;
# /api/healthz stays open for health checks). Leave it empty and there is no
# login at all — fine for `npm run dev` on your own machine, a mistake on a
# reachable port. See "Access control" in README.md.
WEB_AUTH_PASSWORD=

# The user shown until one is chosen. With two or more users in the database
# the sidebar offers a switcher (and `?user=<uuid>` on any page picks one);
# the choice lives in a cookie, not here. See "Choosing a user" in README.md.
PULS_USER_ID=5ea4d000-0000-4000-8000-000000000001

# IANA time zone used for Today, greetings, chart buckets and day boundaries.
# Must match the server stack's PULS_TIME_ZONE (and the phone's zone). When it
# differs from the database's puls_time_zone(), the viewer stops using the
# metric_daily view and buckets raw samples locally instead.
PULS_TIME_ZONE=UTC

# Database connections the viewer holds at most (default 4, 1–50). Raise it
# when several people use the viewer at once. See README.md.
# WEB_DB_POOL_SIZE=4

# Accounts mode behind a TLS proxy (see "Access control" in README.md).
# TRUST_PROXY_HEADERS takes true/false, 1/0, yes/no or on/off (any case);
# anything else stops the viewer at startup, as it stops ingest and the API.
# Behind Cloudflare, take the client address from the header it always
# overwrites; left unset, the last X-Forwarded-For entry is used and the
# viewer warns at startup.
# TRUST_PROXY_HEADERS=true
# WEB_CLIENT_IP_HEADER=cf-connecting-ip
