# Optional outside production: without a database the viewer uses demo data.
DATABASE_URL=

# Set it and the viewer asks for this password over HTTP Basic (any username;
# /api/healthz stays open for health checks). Leave it empty and there is no
# login at all — fine for `npm run dev` on your own machine, a mistake on a
# reachable port. See "Access control" in README.md.
WEB_AUTH_PASSWORD=

# The single user whose health data this read-only viewer displays.
PULS_USER_ID=5ea4d000-0000-4000-8000-000000000001

# IANA time zone used for Today, greetings, chart buckets and day boundaries.
# Must match the server stack's PULS_TIME_ZONE (and the phone's zone). When it
# differs from the database's puls_time_zone(), the viewer stops using the
# metric_daily view and buckets raw samples locally instead.
PULS_TIME_ZONE=UTC
