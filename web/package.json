{
  "name": "puls-web",
  "version": "0.1.0",
  "private": true,
  "description": "Sleek web frontend for the Puls self-hosted HealthKit data store",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext .js,.mjs,.ts,.tsx . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "check:catalog": "node scripts/gen-catalog.mjs --check"
  },
  "dependencies": {
    "geist": "^1.3.1",
    "leaflet": "^1.9.4",
    "next": "^16.3.4",
    "pg": "^8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
