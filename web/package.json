{
  "name": "puls-web",
  "version": "0.1.0",
  "private": true,
  "description": "Sleek web frontend for the Puls self-hosted HealthKit data store",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext .js,.mjs,.ts,.tsx . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "check:catalog": "node scripts/gen-catalog.mjs --check"
  },
  "dependencies": {
    "geist": "^1.3.1",
    "leaflet": "^1.9.4",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^10.10.0",
    "eslint-config-next": "15.5.19",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
