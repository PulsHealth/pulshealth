          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.identifier AS type, sum(h.n)::bigint AS rows, min(h.bucket) AS earliest, max(h.bucket) AS latest FROM quantity_rollups h JOIN sample_types t USING (type_id) GROUP BY 1 UNION ALL SELECT t.identifier, count(*), min(c.start_ts), max(c.start_ts) FROM category_samples c JOIN sample_types t USING (type_id) GROUP BY 1 UNION ALL SELECT 'HKWorkoutTypeIdentifier', count(*), min(start_ts), max(start_ts) FROM workouts UNION ALL SELECT 'aggregate_samples (' || (SELECT count(*) FROM aggregate_series) || ' series)', count(*), min(bucket_start), max(bucket_start) FROM aggregate_samples ORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "title": "Row Counts by Type",
      "type": "table",
      "description": "Quantity counts come from the hourly rollup (hour-precision timestamps, ≤30 min materialization lag) so refreshes never scan the full hypertable."
