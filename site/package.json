{
  "name": "pulshealth-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-blog-images": "bun scripts/blog-images.ts",
    "gen-llms-txt": "bun scripts/gen-llms-txt.ts",
    "gen-openapi": "bun scripts/gen-openapi.ts",
    "predev": "bun run gen-llms-txt && bun run gen-openapi",
    "dev": "bun scripts/dev.ts",
    "prebuild": "bun run copy-blog-images && bun run gen-llms-txt && bun run gen-openapi",
    "build": "next build && bun run check:export",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test tests",
    "check:export": "bun scripts/check-export.ts",
    "blog:check": "bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.8",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
