# Form submission endpoint (API Gateway). Unset it and the two forms say so instead of failing.
NEXT_PUBLIC_FORM_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/
# Optional, public build-time configuration for self-hosted website analytics.
# No API key or other credential belongs here. Unset both to disable collection.
NEXT_PUBLIC_ANALYTICS_URL=https://analytics.example.com
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=00000000-0000-4000-8000-000000000000
